<?xml version='1.0' encoding='utf-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_event_qrscan</name>
	<author>Event QR Scan Module</author>
	<creationDate>2026-09-12</creationDate>
	<copyright>GPLv3</copyright>
	<license>GNU General Public License version 2 or later</license>
	<infourl type="developer">https://github.com/franshst/mod_event_qrscan</infourl>
	<authorEmail>admin@example.com</authorEmail>
	<authorUrl>https://github.com/franshst/mod_event_qrscan</authorUrl>
	<version>1.0.4</version>
	<description>MOD_EVENT_QRSCAN_XML_DESCRIPTION</description>
	<namespace>EventQRScan</namespace>
	<files>
		<filename module="mod_event_qrscan">mod_event_qrscan.php</filename>
		<filename>index.html</filename>
		<folder>tmpl</folder>
		<folder>Helper</folder>
		<folder>language</folder>
		<folder>js</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="checkin_interval" type="text" label="MOD_EVENT_QRSCAN_CHECKIN_INTERVAL" default="2000" />
				<field name="ticket_max_length" type="text" label="MOD_EVENT_QRSCAN_TICKET_MAX_LENGTH" default="32" />
				<field name="text_success_class" type="text" label="MOD_EVENT_QRSCAN_TEXT_SUCCESS_CLASS" default="text-success" />
				<field name="text_warning_class" type="text" label="MOD_EVENT_QRSCAN_TEXT_WARNING_CLASS" default="text-danger" />
				<field name="layout" type="list" label="MOD_EVENT_QRSCAN_LAYOUT" default="default">
					<option value="default">Default</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>