<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_event_qrscan</name>
	<author>Frans Stuurman</author>
	<creationDate>2026-09-12</creationDate>
	<copyright>Frans Stuurman 2026</copyright>
	<license>MIT</license>
	<infourl type="developer">https://github.com/franshst/mod_event_qrscan</infourl>
	<authorUrl>https://github.com/franshst/mod_event_qrscan</authorUrl>
	<version>{VERSION}</version>
	<description>Module replaces the Event Booking QRCODE scanner with a faster browser native implementation</description>
	<namespace>EventQRScan</namespace>
	<files>
		<filename module="mod_event_qrscan">mod_event_qrscan.php</filename>
		<filename>index.html</filename>
		<folder>tmpl</folder>
		<folder>Helper</folder>
		<folder>language</folder>
		<folder>js</folder>
	</files>
	<updateservers>
		<server type="extension" priority="1" name="Mod Event QR Scan">https://github.com/franshst/mod_event_qrscan/releases/latest/download/event_qrscan_update.xml</server>
	</updateservers>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="checkin_interval"
					type="text"
					label="MOD_EVENT_QRSCAN_CHECKIN_INTERVAL"
					default="2000"
				/>
				<field
					name="ticket_max_length"
					type="text"
					label="MOD_EVENT_QRSCAN_TICKET_MAX_LENGTH"
					default="32"
				/>
				<field
					name="text_success_class"
					type="text"
					label="MOD_EVENT_QRSCAN_TEXT_SUCCESS_CLASS"
					default="text-success"
				/>
				<field
					name="text_warning_class"
					type="text"
					label="MOD_EVENT_QRSCAN_TEXT_WARNING_CLASS"
					default="text-danger"
				/>
				<field
					name="scan_fps"
					type="number"
					label="MOD_EVENT_QRSCAN_SCAN_FPS"
					default="2"
					min="1"
					max="10"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
